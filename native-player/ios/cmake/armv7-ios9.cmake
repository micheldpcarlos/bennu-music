set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR armv7)
set(CMAKE_OSX_ARCHITECTURES armv7 CACHE STRING "" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 9.0 CACHE STRING "" FORCE)
if(NOT IPAD_SDK OR NOT IS_DIRECTORY "${IPAD_SDK}")
    message(FATAL_ERROR "Pass -DIPAD_SDK=<normalized legacy SDK>")
endif()
if(NOT IPAD_CXX_HEADERS OR NOT EXISTS "${IPAD_CXX_HEADERS}/string")
    message(FATAL_ERROR "Pass -DIPAD_CXX_HEADERS=<libcxx-3.8.1.src/include>")
endif()
set(CMAKE_OSX_SYSROOT "${IPAD_SDK}" CACHE PATH "" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER /usr/bin/clang CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER /usr/bin/clang++ CACHE FILEPATH "")
set(CMAKE_C_COMPILER_TARGET armv7-apple-ios9.0)
set(CMAKE_CXX_COMPILER_TARGET armv7-apple-ios9.0)
set(CMAKE_C_FLAGS_INIT "-marm")
set(CMAKE_CXX_FLAGS_INIT "-marm -stdlib=libc++ -nostdinc++ -isystem \"${IPAD_CXX_HEADERS}\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-lc++abi")
set(CMAKE_FIND_ROOT_PATH "${IPAD_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED NO)
set(CMAKE_CXX_STANDARD 14 CACHE STRING "" FORCE)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
# Propagate inputs to try_compile projects.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES IPAD_SDK IPAD_CXX_HEADERS)
